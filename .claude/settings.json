{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(codex:*)",
      "Bash(scripts/codex_implement.sh:*)",
      "Bash(./scripts/codex_implement.sh:*)",
      "Bash(scripts/codex_review.sh:*)",
      "Bash(./scripts/codex_review.sh:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-detekt.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-api-config.sh\""
          }
        ]
      }
    ]
  }
}
